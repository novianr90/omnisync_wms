# --- ENVIRONMENT ---
# Options: development, staging, production
APP_ENV=production

# --- DOCKER COMPOSE PROFILES ---
# Uncomment this line to run the local PostgreSQL database container.
# If you are using Supabase or an external database, leave this commented out.
# COMPOSE_PROFILES=local-db

# --- DATABASE CONFIGURATION ---
DB_TYPE=postgres

# Local Docker Database Credentials (used if COMPOSE_PROFILES=local-db)
POSTGRES_USER=omnisync
POSTGRES_PASSWORD=omnisync_secret
POSTGRES_DB=omnisync_wms

# Connection strings for the services. 
# If using local docker DB, leave these as they are.
# If using Supabase, replace these with your Supabase Transaction connection pooler strings (add ?sslmode=require)
AUTH_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable
WMS_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable

# --- SECURITY ---
# A strong 32+ character secret for JWT token signing
JWT_SECRET_KEY=your_super_secret_jwt_key_here_please_change

# --- DEFAULT SANDBOX CREDENTIALS (ONLY APPLIES IF APP_ENV IS NOT production) ---
# In production, use the CLI `go run cmd/main.go create-admin email pass` inside the auth container instead.
SEED_ADMIN_EMAIL=admin@omnisync.com
SEED_ADMIN_PASSWORD=sandbox_admin_secret
SEED_OPERATOR_EMAIL=operator@omnisync.com
SEED_OPERATOR_PASSWORD=sandbox_operator_secret

# --- CLOUDFLARE TUNNEL ---
# Provide your tunnel token to expose the Nginx reverse proxy to the internet safely.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
TUNNEL_DOMAIN=wms.omnisync.com
