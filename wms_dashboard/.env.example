# ─────────────────────────────────────────────
# Omnisync WMS – Dashboard Service · .env.example
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────

# JWT signing secret — must match auth_services JWT_SECRET_KEY exactly
# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=your-strong-random-jwt-secret-here

# Server port
PORT=9901

# Auth service base URL
AUTH_API_URL=http://localhost:8000

# Database driver: sqlite | postgres
DB_TYPE=sqlite

# Postgres DSN (only used when DB_TYPE=postgres)
WMS_DATABASE_URL=host=localhost user=wms_admin password=CHANGE_ME dbname=db_wms port=5432 sslmode=disable
