# ─────────────────────────────────────────────
# Omnisync WMS – Auth Service · .env.example
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────

# JWT signing secret — must match wms_dashboard JWT_SECRET_KEY exactly
# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=your-strong-random-jwt-secret-here

# Server port
PORT=8000

# Allowed CORS origin (comma-separated)
ALLOWED_ORIGIN=http://localhost:9901,http://127.0.0.1:9901

# Database driver: sqlite | postgres
DB_TYPE=sqlite

# Postgres DSN (only used when DB_TYPE=postgres)
AUTH_DATABASE_URL=host=localhost user=auth_admin password=CHANGE_ME dbname=db_auth port=5432 sslmode=disable

# Seed user credentials (used only on first boot when DB is empty)
SEED_ADMIN_EMAIL=admin@omnisync.com
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_OPERATOR_EMAIL=operator@omnisync.com
SEED_OPERATOR_PASSWORD=CHANGE_ME
