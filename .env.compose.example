# --- ENVIRONMENT ---
APP_ENV=production

# --- DATABASE CONFIGURATION ---
DB_TYPE=postgres
POSTGRES_USER=omnisync
POSTGRES_PASSWORD=omnisync_secret
POSTGRES_DB=omnisync_wms

# When using local-db compose override, services reach postgres via the container name:
AUTH_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable
WMS_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable

# When using Supabase (or another external Postgres), set full connection strings here
# and omit COMPOSE_PROFILES=local-db from your run command:
# AUTH_DATABASE_URL=postgres://user:pass@db.supabase.co:5432/postgres?sslmode=require
# WMS_DATABASE_URL=postgres://user:pass@db.supabase.co:5432/postgres?sslmode=require

# --- SECURITY ---
JWT_SECRET_KEY=your_super_secret_jwt_key_here_please_change

# --- CORS (WMS dashboard origin served by nginx) ---
ALLOWED_ORIGIN=http://localhost,https://wms.yourdomain.com

# --- CLOUDFLARE TUNNEL (activate with --profile tunnel) ---
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
TUNNEL_DOMAIN=wms.yourdomain.com
